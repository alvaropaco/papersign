###########################
#     BASE CONTAINER      #
###########################
FROM node:24-alpine3.23 AS base

RUN apk add --no-cache openssl
RUN apk add --no-cache font-freefont


###########################
#     BUILD CONTAINER     #
###########################
FROM base AS builder

# Native dependencies from the full workspace still need a toolchain even when
# we only build @documenso/docs.
RUN apk add --no-cache libc6-compat jq make cmake g++ bash
WORKDIR /app

COPY . .

ENV HUSKY=0
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_OPTIONS="--max-old-space-size=4096"

# A full-workspace install keeps the workspace-root Tailwind v3 compatibility
# package required by Fumadocs' typography plugin. Turbo prune drops that root
# dependency because @documenso/docs does not depend on the shared Tailwind
# workspace package directly.
RUN npm ci --no-audit --no-fund
RUN npm run build --workspace=@documenso/docs


###########################
#     RUNNER CONTAINER    #
###########################
FROM base AS runner

ENV HUSKY=0
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nodejs

USER nodejs

WORKDIR /app

# Next standalone output preserves the monorepo path: /app/apps/docs/server.js.
COPY --from=builder --chown=nodejs:nodejs /app/apps/docs/.next/standalone ./
COPY --from=builder --chown=nodejs:nodejs /app/apps/docs/.next/static ./apps/docs/.next/static
COPY --from=builder --chown=nodejs:nodejs /app/apps/docs/public ./apps/docs/public

WORKDIR /app/apps/docs

CMD ["node", "server.js"]
